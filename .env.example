# --- Vercel Postgres (added automatically when you attach Vercel Postgres storage to the project) ---
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# --- Cron security ---
# Vercel automatically sends this as a Bearer token to your cron route when this is set
# in your Project Settings > Environment Variables. Generate any long random string.
CRON_SECRET=replace-with-a-long-random-string

# --- Admin access (listing petition signatures) ---
# Not sent automatically by anything — this is only checked by /api/petition/list.
# Generate a separate long random string; keep it private.
ADMIN_SECRET=replace-with-a-different-long-random-string

# --- Hypothetical fee model (illustrative only — see docs/BUSINESS_PLAN.md) ---
HYPOTHETICAL_FEE_USD_PER_PASS=25
INCLINATION_COVERAGE_FACTOR=0.75
ORBITS_PER_DAY_ASSUMED=15

# --- Which TLE catalog group to pull each cron run ---
# "active" is the full ~16,500-satellite catalog. lib/cronRunner.ts pre-filters
# it by orbital inclination (skips anything that can never reach Serbia's
# latitude) before propagating anything, so "active" should be fine even on
# Hobby-tier limits — but a smaller group (e.g. "stations", "starlink") is
# still an option if you want faster/cheaper runs.
CELESTRAK_GROUP=active

# --- Cron run tuning (all optional — sane defaults in lib/cronRunner.ts) ---
# How far forward each run samples per candidate satellite, and how finely.
# A single instant is mostly luck (Serbia is small); sampling a window turns
# one invocation into many chances. See docs/BUILD_LOG.md ("the live map
# doesn't update") for why this exists.
# CRON_WINDOW_SECONDS=240
# CRON_STEP_SECONDS=15
# Hard cutoff so the job always finishes and always writes cron_status —
# keep this comfortably under your actual plan's function-timeout ceiling
# (the route files request maxDuration=60, but confirm your plan honors that).
# CRON_TIME_BUDGET_MS=45000
# CRON_FETCH_TIMEOUT_MS=15000
